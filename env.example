# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./fantasy.db

# Official FantasyPros API. Responses are cached in SQLite for seven days by
# default so the free 50-call daily allowance is not spent on repeated reads.
FANTASYPROS_API_KEY=your_api_key_here
FANTASYPROS_API_BASE_URL=https://api.fantasypros.com/public/v2/json
FANTASYPROS_DAILY_CALL_BUDGET=50
FANTASYPROS_PROJECTIONS_SCHEDULE_CRON="15 9 * * 3"

# Free draft-market feeds are captured daily. Each provider is isolated so one
# outage cannot prevent the other histories from accumulating.
DRAFT_SOURCES_SCHEDULE_CRON="15 11 * * *"
DRAFT_SCORING=PPR
DRAFT_LEAGUE_SIZE=12

# Yahoo OAuth Configuration. Yahoo requires an HTTPS redirect; for local
# development, use a tunnel that forwards its public host to localhost:8000.
YAHOO_CLIENT_ID=your_client_id_here
YAHOO_CLIENT_SECRET=your_client_secret_here
YAHOO_REDIRECT_URI=https://your-public-host.example/auth/yahoo/callback
YAHOO_FRONTEND_CALLBACK_URI=http://localhost:5173/auth/callback

# RSS News Sources (comma-separated)
NEWS_FEEDS=https://www.espn.com/espn/rss/nfl/news,https://www.nfl.com/feed/news

# Application Settings
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS Settings (for local development)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
